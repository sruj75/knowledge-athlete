<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>omi</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIconFile</key>
    <string>OmiIcon</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Omi needs screen recording permission to monitor your focus and detect distractions.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Omi needs microphone access to transcribe your conversations in real-time.</string>
	<key>NSLocationUsageDescription</key>
	<string>Omi can attach one location snapshot to a conversation when you allow it.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Omi needs permission to capture system audio for transcription of calls and meetings.</string>
	<key>CFBundleURLTypes</key>
    <array>
        <dict>
			<key>CFBundleURLName</key>
			<string>Intentive Auth Callback</string>
            <key>CFBundleURLSchemes</key>
            <array>
				<string>heyintentive-dev</string>
            </array>
        </dict>
    </array>
    <!-- The release provider sets both keys for published preview artifacts. The owned preview
         identity remains the runtime safety boundary if this marker is absent. -->
    <key>OMIExternalPreview</key>
    <false/>
    <key>OMIExternalPreviewBackend</key>
    <string>production</string>
    <!-- Sparkle Auto-Update Configuration -->
	<!-- Release provider must stamp these four values before signing. Empty values
	     deliberately disable Sparkle; there is no inherited Omi fallback. -->
	<key>IntentiveManualDownloadURL</key>
	<string></string>
	<key>IntentivePrivacyURL</key>
	<string></string>
	<key>IntentiveProductURL</key>
	<string></string>
	<key>IntentiveProductionAPIURL</key>
	<string></string>
	<key>IntentiveReleasesURL</key>
	<string></string>
	<key>IntentiveSupportURL</key>
	<string></string>
	<key>IntentiveTermsURL</key>
	<string></string>
	<key>SUFeedURL</key>
	<string></string>
	<key>SUPublicEDKey</key>
	<string></string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUScheduledCheckInterval</key>
    <integer>600</integer>
</dict>
</plist>
