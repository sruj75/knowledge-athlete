# Desktop macOS App — Environment Variables
# Copy app-specific local values to .env.app.dev. run.sh prefers .env.app.dev,
# then .env.app, and injects only selected Firebase, backend, and public analytics
# bootstrap values; it never copies backend/.env wholesale.
#
# The Swift app merges every readable file in this order (later files override
# earlier bundled values; explicit launch-environment values remain authoritative):
#   1. App bundle: Contents/Resources/.env
#   2. Current directory: ./.env
#   3. Home directory: ~/.omi.env

# ─── Required ────────────────────────────────────────────────────────

# Canonical backend API URL. It serves desktop config/proxy routes alongside
# subscriptions, payments, transcription, auth, and the other retained APIs.
# Local dev:    http://localhost:8080  (if running Python backend locally)
# Owned public-ingress development service; protected routes require Firebase authentication:
OMI_PYTHON_API_URL=https://knowledge-athlete-dev-sbgrr24rwa-uw.a.run.app

# Firebase Web API key used for authentication bootstrap. run.sh can inject it
# from the launch environment or backend/.env when it is absent here.
# FIREBASE_API_KEY=

# Owned PostHog project configuration for named/local development bundles.
# Stable and Beta ignore environment overrides and use only signed bundle metadata.
# The project token is a public client identifier, not an administrative credential,
# but keep the real value in the ignored .env.app.dev file and in Codemagic rather
# than this tracked template.
# POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Managed AI credentials, including GEMINI_API_KEY, are backend-only and are
# deliberately rejected by the macOS environment loader.
