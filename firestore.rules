rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Client Firestore access is closed by default. Backend/Admin SDK access is
    // governed by IAM and bypasses these client rules.
    match /users/{uid}/{collectionId}/{document=**} {
      allow read, create, update, delete: if false;
    }

    // Existing client-access rules must be added explicitly before deployment if
    // a Firebase project relies on direct client Firestore access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
