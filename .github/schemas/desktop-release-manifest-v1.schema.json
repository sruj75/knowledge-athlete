{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omi.me/schemas/desktop-release-manifest-v1.schema.json",
  "$comment": "Structural projection of the authoritative executable contract in .github/scripts/desktop_release_manifest.py. Schema-only validation is insufficient for cross-field identity and provenance rules.",
  "x-omi-executable-contract": ".github/scripts/desktop_release_manifest.py",
  "title": "Omi Desktop Release Manifest v1",
  "description": "Immutable identity for one qualified macOS app release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "platform",
    "version",
    "build_number",
    "app_source_sha",
    "zip_url",
    "zip_sha256",
    "dmg_url",
    "dmg_sha256",
    "ed_signature",
    "qualification_evidence_asset",
    "qualification_evidence_sha256",
    "qualification_tier",
    "qualification_passed",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?\\+[1-9][0-9]*-macos$"
    },
    "platform": { "const": "macos" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "build_number": { "type": "integer", "minimum": 1 },
    "app_source_sha": { "$ref": "#/$defs/sourceSha" },
    "zip_url": { "$ref": "#/$defs/zipUrl" },
    "zip_sha256": { "$ref": "#/$defs/sha256" },
    "dmg_url": { "$ref": "#/$defs/dmgUrl" },
    "dmg_sha256": { "$ref": "#/$defs/sha256" },
    "ed_signature": { "type": "string", "pattern": ".*\\S.*" },
    "qualification_evidence_asset": {
      "type": "string",
      "pattern": "^(qualification-evidence-[^/]+\\.json|desktop-smoke-result\\.json)$"
    },
    "qualification_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "qualification_tier": { "enum": ["T2", "emergency"] },
    "qualification_passed": { "type": "boolean" },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "changelog": {
      "type": "array",
      "items": { "type": "string", "pattern": ".*\\S.*" }
    },
    "mandatory": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "qualification_tier": { "const": "T2" } } },
      "then": { "properties": { "qualification_passed": { "const": true } } },
      "else": {
        "properties": {
          "qualification_passed": { "const": false },
          "qualification_evidence_asset": { "const": "desktop-smoke-result.json" }
        }
      }
    }
  ],
  "$defs": {
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "zipUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/BasedHardware/omi/releases/download/v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:%2[Bb]|\\+)[1-9][0-9]*-macos/Omi\\.zip$"
    },
    "dmgUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/BasedHardware/omi/releases/download/v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:%2[Bb]|\\+)[1-9][0-9]*-macos/omi\\.dmg$"
    }
  }
}
