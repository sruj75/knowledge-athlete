# Production reference — DO NOT USE LOCALLY
#
# Production Cloud Run receives env vars from deployment config
# and GCP Secret Manager. This file documents required keys only.
#
# Never commit backend/.env.prod or put production secrets on a laptop.
# Never set OMI_ENV_STAGE=prod for local development.

# OMI_ENV_STAGE=prod
# ENVIRONMENT=production

# --- Firebase / GCP (owned production — reference values only) ---
# GOOGLE_CLOUD_PROJECT=YOUR_OWNED_RUNTIME_GCP_PROJECT_ID
# FIREBASE_PROJECT_ID=YOUR_OWNED_FIREBASE_PROJECT_ID
# FIREBASE_AUTH_DOMAIN=YOUR_OWNED_FIREBASE_PROJECT_ID.firebaseapp.com
# Hosted Firebase/Firestore uses the attached Cloud Run service account through ADC.
# SERVICE_ACCOUNT_JSON and GOOGLE_APPLICATION_CREDENTIALS are forbidden here.
# FIRESTORE_DATABASE_ID=(default)

# --- API URLs (stable owned Cloud Run URL; no custom backend domain) ---
# BASE_API_URL=https://YOUR_OWNED_PROD_SERVICE_HASH.run.app
# API_BASE_URL=https://YOUR_OWNED_PROD_SERVICE_HASH.run.app

# --- Provider / infra (production secret manager — DO NOT fill locally) ---
# ADMIN_KEY=
# OPENAI_API_KEY=  # POST /v1/audio/speech only
# MODULATE_API_KEY=
# GEMINI_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_PROMPT_NAME=intentive-chat-system
# LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
# Production currently shares the intentive-development Upstash free database with development.
# Keep the production GitHub environment and Secret Manager binding separate even while values point to the shared host.
# REDIS_DB_HOST=YOUR_UPSTASH_REDIS_HOST
# REDIS_DB_PORT=6379
# REDIS_DB_PASSWORD=YOUR_UPSTASH_REDIS_PASSWORD
# REDIS_DB_CA_CERT_PEM=YOUR_UPSTASH_SERVER_CA_PEM
# BUCKET_DESKTOP_UPDATES=YOUR_OWNED_PROD_DESKTOP_ARTIFACT_BUCKET
# FIREBASE_API_KEY=
BILLING_MODE=disabled
