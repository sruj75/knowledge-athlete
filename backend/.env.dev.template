# Remote dev GCP + Firebase (cloud dev project, not local emulators)
#
# Use for running the Python backend against the shared dev cloud stack.
# DO NOT use emulator hosts with this stage.
#
# Setup:
#   cp backend/.env.dev.template backend/.env.dev
#   # Authenticate local ADC with `gcloud auth application-default login`.
#   # Fill owned project coordinates and exact development secrets below.
#   ln -sf .env.dev backend/.env
#
# Never commit backend/.env.dev or backend/.env.

OMI_ENV_STAGE=dev
ENVIRONMENT=development

# --- Firebase / GCP (owned dev projects — non-secret structure) ---
GOOGLE_CLOUD_PROJECT=YOUR_OWNED_RUNTIME_GCP_PROJECT_ID
FIREBASE_PROJECT_ID=YOUR_OWNED_FIREBASE_PROJECT_ID
FIREBASE_AUTH_DOMAIN=YOUR_OWNED_FIREBASE_PROJECT_ID.firebaseapp.com
FIRESTORE_DATABASE_ID=(default)
CLOUD_RUN_VPC_NETWORK=YOUR_OWNED_DEV_VPC
CLOUD_RUN_VPC_SUBNET=YOUR_OWNED_DEV_US_WEST1_SUBNET
PRIVATE_SERVICE_ACCESS_RANGE_NAME=YOUR_OWNED_DEV_PRIVATE_SERVICE_RANGE
PRIVATE_SERVICE_ACCESS_RANGE_CIDR=YOUR_APPROVED_NON_OVERLAPPING_DEV_CIDR
REDIS_INSTANCE_NAME=YOUR_OWNED_DEV_REDIS_INSTANCE

# --- API URLs (stable owned Cloud Run URL; no custom backend domain) ---
BASE_API_URL=https://YOUR_OWNED_DEV_SERVICE_HASH.run.app
API_BASE_URL=https://YOUR_OWNED_DEV_SERVICE_HASH.run.app
OPENAI_BASE_URL=https://api.openai.com/v1

# --- LangSmith (non-secret defaults) ---
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=omi-backend-chat
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
OMI_LANGSMITH_AGENTIC_PROMPT_NAME=omi-agentic-system
OMI_LANGSMITH_PROMPT_CACHE_TTL_SECONDS=300

# =============================================================================
# SECRETS — fetch exact enabled versions from the owned dev project or your dev vault
# =============================================================================

FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
ADMIN_KEY=YOUR_DEV_ADMIN_KEY

REDIS_DB_HOST=YOUR_DEV_REDIS_HOST
REDIS_DB_PORT=6379
REDIS_DB_PASSWORD=YOUR_DEV_REDIS_PASSWORD
REDIS_DB_CA_CERT_PEM=YOUR_DEV_REDIS_SERVER_CA_PEM
BUCKET_DESKTOP_UPDATES=YOUR_OWNED_DEV_DESKTOP_ARTIFACT_BUCKET

OPENAI_API_KEY=sk-your-openai-dev-key-here
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_DEV_KEY
GEMINI_API_KEY=YOUR_GEMINI_DEV_KEY

HUGGINGFACE_TOKEN=
BUCKET_BACKUPS=
BUCKET_PLUGINS_LOGOS=
MODULATE_API_KEY=
GITHUB_TOKEN=
BILLING_MODE=disabled
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_BILLING_CATALOG_JSON=

GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
LANGSMITH_API_KEY=
