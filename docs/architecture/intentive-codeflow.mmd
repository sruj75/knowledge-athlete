flowchart TD
    %% Conversational product map, 2026-10-14.
    %% Source behavior, not provider, physical-audio, release or eight-hour soak acceptance.
    %% Authored contract: openwiki/INSTRUCTIONS.md, Conversational product decision.

    subgraph IDENTITY["Account and local ownership"]
      AUTH["Firebase sign-in / session restoration"]
      OWNER["RuntimeOwnerIdentity<br/>owner + authorization generation"]
      FENCE["Reject old account, capture, conversation and connection callbacks"]
      AUTH --> OWNER --> FENCE
    end

    subgraph OBSERVATION["Independent permitted inputs"]
      MIC["Microphone → ambient transcription"]
      SYSTEM["System audio → ambient transcription"]
      SCREEN["Fresh permitted screen JPEG<br/>2 MB decoded cap"]
      CAMERA["Opt-in AVFoundation webcam<br/>latest frame only; no recording<br/>1 fps / 640 px / 256 KB / 5 s freshness"]
      CAPTURE["Capture status and app context<br/>clear invalid frames on lock/sleep/account change"]
      SNAPSHOT["Bounded observation snapshot<br/>separate screen/webcam identity and capture age<br/>partial transcript revisions + active conversation state"]
      MIC --> SNAPSHOT
      SYSTEM --> SNAPSHOT
      SCREEN --> SNAPSHOT
      CAMERA --> SNAPSHOT
      CAPTURE --> SNAPSHOT
      FENCE --> SNAPSHOT
    end

    subgraph SUPERVISOR["B: observe and guide"]
      SCHEDULE["Sample up to 1 Hz<br/>changed context: fixed 1 s coalesce<br/>quiet context: fresh images after 30 s"]
      BUDGET["Shared capacity 3 / refill 1 per 5 s<br/>one inference + one replaceable pending snapshot"]
      B["Authenticated Supervisor endpoint<br/>Gemini 3.8 Flash / low thinking<br/>4 MB request cap"]
      DECISION{"wait / guide / intervene"}
      CUE["Private cue<br/>owner/context scoped; bounded; acknowledge once<br/>expires 30 s after observation admission"]
      DEGRADED["Quota/provider degradation visible<br/>resume at allowed retry/reset"]
      SNAPSHOT --> SCHEDULE --> BUDGET --> B --> DECISION
      B --> DEGRADED --> BUDGET
      DECISION -->|"guide or permitted intervene"| CUE
      DECISION -->|"wait"| SCHEDULE
    end

    subgraph CONVERSATION["One logical A conversation"]
      SHORTCUT["User taps shortcut<br/>open or explicit close"]
      SURFACE["Original notch + floating conversation<br/>same surface for user and B; stays open between replies<br/>blue opening glow, thinking, mic wave and playback feedback"]
      LIFE["ConversationVoiceController + lifecycle<br/>closed → connecting → open → reconnecting → ending"]
      BOOT["POST /v1/conversation/session<br/>immutable prompt receipt before Live connection"]
      LIVE["Native Gemini Live<br/>automatic voice detection / persistent connection<br/>bounded same-provider recovery"]
      DUPLEX["Shared voice-processing audio engine<br/>processed mic and controlled PCM playback<br/>actual mic/render levels drive original visuals"]
      INTERRUPT["Spoken interruption<br/>stop + flush output; cancel obsolete work<br/>reject late turn/connection callbacks"]
      FALLBACK["Sticky fallback for this conversation<br/>Silero: 500 ms preroll / 800 ms trailing silence<br/>batch STT → direct A → generated or system TTS"]
      DIRECT["POST /v1/conversation/respond<br/>bounded dialogue + current message + permitted context<br/>backend-owned instruction and request construction"]
      SAFE["Idle boundary only<br/>silent private append; turnComplete false<br/>queue while generating/playing"]
      END["End: user closure, fixed end_conversation after playback,<br/>or 60 s of available-input listening silence<br/>busy/recovery pauses timer; newer user activity supersedes end"]
      SHORTCUT --> LIFE
      SURFACE <--> LIFE
      CUE -->|"closed + proactive allowed"| LIFE
      LIFE --> BOOT --> LIVE
      LIVE <--> DUPLEX
      DUPLEX -->|"user speech during output"| INTERRUPT --> LIFE
      LIVE -->|"bounded recovery exhausted"| FALLBACK --> DIRECT
      DIRECT --> FALLBACK --> DUPLEX
      SURFACE -->|"typed while Live open; same A"| LIVE
      SURFACE -->|"typed alone or fallback; same pinned receipt"| DIRECT
      CUE -->|"open conversation"| SAFE --> LIVE
      SAFE -->|"fallback context"| DIRECT
      LIFE --> END --> LIFE
    end

    subgraph HISTORY["Canonical persistence and retained knowledge"]
      JOURNAL[("Existing Node / SQLite conversation journal<br/>storage only; no Pi, tools or delegation<br/>account + conversation generation fences<br/>stable IDs, revisions, idempotency, recovery")]
      PROJECTION["Accepted-before-visible UI projection<br/>completed / interrupted / failed playback outcomes"]
      AMBIENT[("Owner-local transcripts and notes")]
      ENRICH["Retained discard/summary/structure + generic Memory extraction<br/>retired pending action-item jobs superseded"]
      MEMORY[("Memory, consolidation, embeddings, profile<br/>historical tips-tagged Memory retained")]
      REWIND[("Rewind archive + OCR + local vectors<br/>separate from Supervisor fresh-frame requests")]
      HISTORICAL[("Historical Tasks/goals/Insights/Focus tables and decoding<br/>no active producers, navigation, widgets or reminders")]
      EXPORT["Owner-authorized exports<br/>paged historical Focus; no 500-row cutoff"]
      LIFE -->|"stable exchange revisions"| JOURNAL --> PROJECTION --> SURFACE
      PROJECTION -->|"bounded transcript revisions + delivery outcomes"| SNAPSHOT
      MIC --> AMBIENT
      SYSTEM --> AMBIENT
      AMBIENT --> ENRICH --> MEMORY
      SCREEN -->|"independent archival admission"| REWIND
      MEMORY -->|"bounded permitted context"| B
      MEMORY -->|"bounded permitted context"| DIRECT
      MEMORY -->|"bounded permitted context"| LIVE
      JOURNAL --> EXPORT
      AMBIENT --> EXPORT
      MEMORY --> EXPORT
      HISTORICAL --> EXPORT
    end

    subgraph ENGINEERING["Instructions and measurement"]
      LANGFUSE["Langfuse versioned instructions<br/>A pinned per logical conversation; B per evaluation<br/>coaching behavior edited outside this implementation"]
      REPO["One versioned tool-free A fallback<br/>only at conversation creation"]
      METRICS["Model version; exclusive input/cached/output/thinking counts<br/>capture age / queue / provider / end-to-end latency<br/>local content-free A/B acceptance snapshots<br/>skip and quota gaps; no private guidance, image or raw-audio exports"]
      LANGFUSE --> BOOT
      LANGFUSE --> B
      REPO --> BOOT
      B --> METRICS
      LIVE --> METRICS
      DIRECT --> METRICS
    end
