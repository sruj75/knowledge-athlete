{
  "name": "intentive-codebase-map",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run test:browser",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "mermaid": "12.0.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
